+
+
+#' Coefficient matrix of the VAR equations ("Estimate" column of \code{coef(var)}), one row per equation
+#' @param var a \code{varest} object
+#' @export
+#' @noRd
+coefmatrixEV <- function(var) {
+	cv <- coef(var)
+	do.call(rbind, lapply(cv, function(x) x[, "Estimate"]))
+}
